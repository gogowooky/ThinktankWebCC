{
  "name": "thinktank",
  "private": true,
  "version": "2.7.2",
  "type": "module",
  "scripts": {
    "build:electron-shared": "node scripts/build-electron-shared.mjs",
    "dev:vite": "vite",
    "dev:frontend": "vite",
    "predev:electron": "npm run build:electron-shared",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "pretest": "npm run build:electron-shared",
    "test": "node scripts/run-tests.mjs run",
    "pretest:watch": "npm run build:electron-shared",
    "test:watch": "node scripts/run-tests.mjs",
    "pretest:coverage": "npm run build:electron-shared",
    "test:coverage": "node scripts/run-tests.mjs run --coverage",
    "preview": "vite preview",
    "dev:electron": "concurrently -k -n vite,electron -c green,yellow \"cross-env ELECTRON_DEV=true vite\" \"wait-on tcp:5173 && node scripts/dev-electron.mjs\"",
    "preelectron:build": "npm run build:electron-shared",
    "electron:build": "tsc -p tsconfig.json && vite build",
    "electron:package": "npm run electron:build && electron-builder --win --publish never",
    "firebase:deploy": "npm run build && npx firebase-tools deploy --only hosting"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.thinktank.app",
    "productName": "Thinktank",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "electron/**/*",
      "!electron/**/*.test.ts",
      "dist/**/*",
      ".thinktank/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-virtual": "^3.11.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dompurify": "^3.4.12",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase": "^10.14.1",
    "highlight.js": "^11.11.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.474.0",
    "marked": "^18.0.0",
    "marked-highlight": "^2.2.1",
    "monaco-editor": "^0.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.29.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.1",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.5",
    "xlsx": "^0.18.5"
  }
}
