{
  "name": "thinktank",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "dev:frontend": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node scripts/run-tests.mjs run",
    "test:watch": "node scripts/run-tests.mjs",
    "test:coverage": "node scripts/run-tests.mjs run --coverage",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n vite,electron -c green,yellow \"cross-env ELECTRON_DEV=true vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron electron/main.cjs\"",
    "electron:build": "tsc -p tsconfig.json && vite build",
    "electron:package": "npm run electron:build && electron-builder --win --publish never",
    "relay:start": "node scripts/run-relay-agent.mjs",
    "dev:web-relay": "concurrently -k -n relay,vite -c magenta,green \"node scripts/run-relay-agent.mjs\" \"wait-on http://localhost:8080/api/health && vite\"",
    "firebase:deploy": "npm run build && npx firebase-tools deploy --only hosting"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.thinktank.app",
    "productName": "Thinktank",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "electron/**/*",
      "dist/**/*",
      ".thinktank/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@google-cloud/bigquery": "^8.1.1",
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-virtual": "^3.11.2",
    "dompurify": "^3.4.12",
    "dotenv": "^17.3.1",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.3.2",
    "lucide-react": "^0.474.0",
    "marked": "^18.0.0",
    "marked-highlight": "^2.2.1",
    "monaco-editor": "^0.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph": "^1.47.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.1",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.5"
  }
}
