# server/.env にコピーして値を設定する（server/.env は gitignore 済み）

GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# /api/* への共有シークレット認証。
#
# ローカル開発では未設定でよい（認証は無効のまま起動し、警告のみ表示される）。
# Cloud Run 等の公開環境では必須で、未設定を検出するとサーバーは起動を中止する。
# 16文字以上・英数字/ハイフン/アンダースコアのみ（gcloud の値パースが壊れるため）。
#
# ランダムな値を生成: openssl rand -hex 32
#
# 注意: このシークレットはヘッダー X-Thinktank-Api-Key での認証にのみ使われる。
# ヘッダーを付与しているのは vite dev proxy だけなので、ブラウザ版SPAは
# 公開環境で 401 になる。ブラウザから公開URLを使う場合は別途アクセス方式が必要
# （deploy.ps1 -AccessModel Private を推奨）。
API_SHARED_SECRET=
