rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // きなこ（クラウド側 AI）専用アカウント。Vault 所有者の依頼キューとThink本文・スナップショットだけに限定する
    function isKinakoFor(userId) {
      return request.auth != null
        && request.auth.uid == 'eLbzd1Av4TPqqhHpSk1WmM0FXsO2'
        && userId == 'TeJ4FSBAkUNF4xlsOlvEw9egTde2';
    }

    // ユーザー自身の領域のみアクセス可能
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/relayRequests/{requestId} {
      allow read, write: if isKinakoFor(userId);
      match /chunks/{chunkId} {
        allow read, write: if isKinakoFor(userId);
      }
    }

    match /users/{userId}/vaults/{vaultId}/thinks/{thinkId} {
      allow read, write: if isKinakoFor(userId);
      match /snapshots/{snapshotId} {
        allow read, write: if isKinakoFor(userId);
      }
    }
  }
}
