{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "relay",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/run-relay-agent.mjs"],
      "port": 8080,
      "autoPort": false
    },
    {
      "name": "clone-frontend",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--config", "thinktank-clone/vite.config.ts", "thinktank-clone"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "clone-backend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["thinktank-clone/server/index.ts"],
      "port": 8081,
      "autoPort": false
    }
  ]
}
